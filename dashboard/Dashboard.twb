      <column aggregation='None' datatype='integer' name='[Age (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[age]' peg='0' size='2' />
      </column>
      <column caption='Promo Use' datatype='string' name='[Calculation_0453615188713472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [promotion_usage] = 1 THEN &quot;Used Promo&quot;&#13;&#10;ELSE &quot;Did Not Use Promo&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer Segmentation' datatype='string' name='[Calculation_0453615191777281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [income] &lt; 15000 AND [purchase_frequency] = &quot;frequent&quot; THEN &quot;Low Inc - High Freq&quot;&#13;&#10;ELSEIF [income] &lt; 15000 AND [purchase_frequency] = &quot;rare&quot; THEN &quot;Low Inc - Med Freq&quot;&#13;&#10;ELSEIF [income] &lt; 15000 AND [purchase_frequency] = &quot;occasional&quot; THEN &quot;Low Inc - Low Freq&quot;&#13;&#10;&#13;&#10;ELSEIF [income] &gt;= 15000 AND [income] &lt;= 30000 AND [purchase_frequency] = &quot;frequent&quot; THEN &quot;Mid Inc - High Freq&quot;&#13;&#10;ELSEIF [income] &gt;= 15000 AND [income] &lt;= 30000 AND [purchase_frequency] = &quot;rare&quot; THEN &quot;Mid Inc - Med Freq&quot;&#13;&#10;ELSEIF [income] &gt;= 15000 AND [income] &lt;= 30000 AND [purchase_frequency] = &quot;occasional&quot; THEN &quot;Mid Inc - Low Freq&quot;&#13;&#10;&#13;&#10;ELSEIF [income] &gt; 30000 AND [purchase_frequency] = &quot;frequent&quot; THEN &quot;High Inc - High Freq&quot;&#13;&#10;ELSEIF [income] &gt; 30000 AND [purchase_frequency] = &quot;rare&quot; THEN &quot;High Inc - Med Freq&quot;&#13;&#10;ELSEIF [income] &gt; 30000 AND [purchase_frequency] = &quot;occasional&quot; THEN &quot;High Inc - Low Freq&quot;&#13;&#10;END' />
      </column>
      <column caption='Used Promo' datatype='real' name='[Calculation_1036905863221248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [promotion_usage] = 1 THEN 1 ELSE 0 END) / COUNT([promotion_usage])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1036905864216577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &gt;= 18 AND [age] &lt;= 20 THEN &quot;18-20&quot;&#13;&#10;ELSEIF [age] &gt;= 21 AND [age] &lt;= 25 THEN &quot;21-25&quot;&#13;&#10;ELSEIF [age] &gt;= 26 AND [age] &lt;= 30 THEN &quot;26-30&quot;&#13;&#10;ELSEIF [age] &gt;= 31 AND [age] &lt;= 40 THEN &quot;31-40&quot;&#13;&#10;ELSEIF [age] &gt;= 41 AND [age] &lt;= 50 THEN &quot;41-50&quot;&#13;&#10;ELSE &quot;50+&quot;&#13;&#10;END' />
      </column>
